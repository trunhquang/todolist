{
  "rules": {
    "users": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": "auth != null && auth.uid == $userId"
      }
    },
    "workspace_invitations": {
      ".read": "auth != null",
      ".indexOn": ["id", "email"],
      "$workspaceId": {
        ".read": "auth != null",
        ".indexOn": ["id", "email"],
        "$invitationId": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('workspaces').child($workspaceId).child('createdBy').val() == auth.uid || (data.child('email').val() != null && data.child('email').val() == auth.token.email))"
        }
      }
    },
    "workspaces": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "workspace_members": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}